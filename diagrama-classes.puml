@startuml
enum Perfil {
  ESTUDANTE
  EMPRESA
  ADMINISTRADOR
}

enum Modalidade {
  PRESENCIAL
  REMOTA
  HIBRIDA
}

enum SituacaoVaga {
  ABERTA
  ENCERRADA
}

class Usuario {
  - id : Long
  - nome : String
  - email : String
  - perfil : Perfil
}

class Estudante {
  - curso : String
}

class Empresa {
  - nomeEmpresa : String
}

class Administrador {

}

Usuario <|-- Estudante
Usuario <|-- Empresa
Usuario <|-- Administrador

class Area {
  - id : Long
  - nome : String
}

class Vaga {
  - id : Long
  - empresa : Empresa
  - titulo : String
  - descricao : String
  - area : Area
  - localizacao : String
  - modalidade : Modalidade
  - cargaHorariaSemanal : int
  - situacao : SituacaoVaga
  + estaAberta() : boolean
  + encerrar() : void
}



class Candidatura {
  - id : Long
  - estudante : Estudante
  - vaga : Vaga
  - dataInscricao : LocalDate
}

Empresa "1" o-- "0..*" Vaga : publica
Area "1" o-- "0..*" Vaga : classifica
Estudante "1" -- "0..*" Candidatura : realiza
Vaga "1" -- "0..*" Candidatura : recebe
@enduml
